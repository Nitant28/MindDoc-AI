# ============================================================================
# MindDoc AI configuration. Copy to .env and fill in what you need.
# Everything is optional: with no LLM key the app still runs (extractive answers).
# ============================================================================

# --- Security (required for persistent logins) ------------------------------
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./minddoc.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/minddoc

# --- LLM providers: first configured provider in this order is used ----------
# Failing providers are skipped automatically for 60s (circuit breaker).
LLM_PROVIDER_ORDER=anthropic,openai,gemini,nvidia,deepseek,ollama

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (Azure OpenAI, vLLM, LM Studio, Groq, ...)
OPENAI_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA NIM (build.nvidia.com) - OpenAI-compatible
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local, private, offline: `ollama pull llama3.1` then `ollama serve`
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.1

# --- Retrieval / ML ----------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=8

# --- Vision ------------------------------------------------------------------
OCR_ENGINE_ORDER=tesseract,easyocr
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
ENABLE_VISION_CAPTIONS=true
MAX_UPLOAD_MB=50
